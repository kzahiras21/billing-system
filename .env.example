# Generate strong random values; never reuse these examples in production.
JWT_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-24-random-characters
PAYMENT_WEBHOOK_SECRET=replace-with-at-least-24-random-characters
# 32 random bytes encoded as base64 (used for AES-256-GCM field encryption)
FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Secure bootstrap admin (used by prisma/seed.js)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password-14+-characters
BOOTSTRAP_ADMIN_TOTP_SECRET=replace-with-base32-totp-secret

# Network automation stays disabled until the company confirms Freeze/isolation rules.
ENABLE_AUTOMATIC_ISOLATION=false
ENABLE_AUTOMATIC_UNISOLATION=false
GRACE_PERIOD_DAYS=3
