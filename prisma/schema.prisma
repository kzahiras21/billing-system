generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  name             String
  passwordHash     String
  role             String     // SUPER_ADMIN, BOD, FINANCE, MARKETING, SYSTEM
  twoFactorSecret  String?
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  auditLogs        AuditLog[]
}

model Product {
  id          String       @id @default(uuid())
  name        String
  basePrice   Float
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subscribers Subscriber[]
}

model Device {
  id           String      @id @default(uuid())
  macAddress   String      @unique
  serialNumber String      @unique
  status       String      @default("IDLE") // IN_USE, IDLE, FREEZE, BROKEN
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  subscriber   Subscriber?
}

model Subscriber {
  id          String   @id @default(uuid())
  name        String
  phone       String
  whatsapp    String
  email       String
  address     String
  floor       String?
  status      String   @default("ACTIVE") // ACTIVE, FREEZE, DISMANTLE
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  deviceId    String?  @unique
  device      Device?  @relation(fields: [deviceId], references: [id])
  marketingId String?
  invoices    Invoice[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  actorId   String
  actorRole String
  ipAddress String?
  timestamp DateTime @default(now())
  actor     User     @relation(fields: [actorId], references: [id])
}

model Invoice {
  id              String   @id @default(uuid())
  subscriberId    String
  subscriber      Subscriber @relation(fields: [subscriberId], references: [id])
  amount          Float
  taxAmount       Float    // PPN 11%
  totalAmount     Float
  status          String   @default("UNPAID") // UNPAID, PAID, CANCELLED, OVERDUE
  dueDate         DateTime
  virtualAccount  String?
  qrisUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        PaymentTransaction[]
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  transactionId String   @unique // From Payment Gateway to prevent double processing
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])
  amountPaid    Float
  paymentMethod String   // VA, QRIS
  status        String   @default("SETTLEMENT") // SETTLEMENT, PENDING, DENY
  timestamp     DateTime @default(now())
}
